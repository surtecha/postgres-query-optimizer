# Local isolated services only. Compose binds HTTP and database ports to loopback.
PGO_APP_DSN=postgresql+psycopg://pgo_app:local_app_only@app-db:5432/pgo_app
PGO_READ_DSN=postgresql://pgo_reader:local_reader_only@benchmark-db:5432/pgo_benchmark
PGO_ADMIN_DSN=postgresql://pgo_experiment:local_experiment_only@benchmark-db:5432/pgo_benchmark
PGO_STATE_DIR=state
PGO_PROVIDER=deterministic
PGO_MODEL=gpt-4.1-mini
PGO_OPENAI_API_KEY=
PGO_OPENAI_BASE_URL=https://api.openai.com/v1
PGO_API_TOKEN=
PGO_MAX_CANDIDATES=8
PGO_MAX_ROUNDS=3
PGO_STATEMENT_MS=30000
PGO_SESSION_SECONDS=300
PGO_REPETITIONS=10
PGO_MIN_IMPROVEMENT=0.10
PGO_MAX_CV=0.35
PGO_MAX_INDEX_BYTES=67108864
PGO_MAX_MODEL_TOKENS=32000
PGO_MAX_PENDING=16
LANGGRAPH_STRICT_MSGPACK=true

# Ollama running on the Docker Desktop host; no API key needed.
PGO_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
PGO_OLLAMA_MODEL=qwen2.5-coder:3b
PGO_MODEL_TIMEOUT_SECONDS=90
